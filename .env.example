# Server only. Never use VITE_ prefixes for provider keys.
# Alchemy or any standard Solana RPC (preferred when set).
RPC_URL=
ALCHEMY_API_KEY=
# Helius remains supported as a fallback.
HELIUS_RPC_URL=
HELIUS_API_KEY=
BIRDEYE_API_KEY=
JUPITER_API_KEY=
DFLOW_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Meta Model API credentials stay on the server. MODEL_API_KEY is an accepted alias.
META_API_KEY=
META_MODEL=muse-spark-1.3
META_PROTOCOL=responses
VOICE_PROVIDER=meta
GADGET_API_KEY=
PORT=8787
APP_ORIGIN=http://localhost:5173
# Optional Seeker Connect relay that you are authorized to use.
VITE_SEEKER_RELAY_DOMAIN=
